// CloudForge persistence schema (SQLite via Prisma).
//
// JSON-shaped values (tags, variables, outputs, metadata) are stored as TEXT
// containing serialized JSON, because the SQLite connector has no native JSON
// column type. Mapping happens in the repository layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id             String    @id
  name           String
  description    String    @default("")
  environment    String
  region         String
  providerId     String?
  templateId     String?
  status         String    @default("draft")
  tags           String    @default("[]")
  variables      String    @default("{}")
  notes          String    @default("")
  icon           String    @default("")
  color          String    @default("")
  passkeyHash    String?
  passkeySalt    String?
  passkeyVersion Int       @default(1)
  lastOpenedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // A project is linked to a stored Credential (the cloud-provider account used
  // to provision it). `providerId` holds that Credential's id.
  credential  Credential?       @relation(fields: [providerId], references: [id], onDelete: SetNull)
  deployments Deployment[]
  sshKeys     SshKey[]
  activities  Activity[]
  providers   Provider[]
  credentials Credential[]      @relation("ProjectCredentials")
  vpsTargets  VpsTarget[]
  pipelines   JenkinsPipeline[]
  templates   Template[]
  logs        LogEntry[]
  secrets     Secret[]
  settings    Setting[]
  plugins     Plugin[]

  @@index([updatedAt])
}

model Provider {
  id        String   @id
  projectId String
  kind      String // 'oracle' | 'aws' | 'azure' | ...
  name      String
  status    String   @default("disconnected")
  metadata  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credentials Credential[]
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Credential {
  id         String   @id
  projectId  String
  providerId String?
  kind       String // logical credential type, e.g. 'oracle' | 'aws' | 'github'
  name       String
  ciphertext String // encrypted blob (base64) — never plaintext
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider   Provider?   @relation(fields: [providerId], references: [id], onDelete: SetNull)
  projects   Project[]
  vpsTargets VpsTarget[]
  project    Project     @relation("ProjectCredentials", fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model VpsTarget {
  id                  String    @id
  projectId           String
  name                String
  host                String
  port                Int       @default(22)
  username            String
  sshCredentialId     String?
  hostKeySha256       String
  lastPreflight       String    @default("")
  lastPreflightAt     DateTime?
  managedProjectId    String?
  managedResourceName String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sshCredential Credential? @relation(fields: [sshCredentialId], references: [id], onDelete: SetNull)
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, managedProjectId, managedResourceName])
  @@index([projectId])
  @@index([updatedAt])
  @@index([sshCredentialId])
}

model JenkinsPipeline {
  id                      String   @id
  projectId               String
  name                    String
  folder                  String
  description             String   @default("")
  targetId                String
  jenkinsCredentialId     String
  githubCredentialId      String?
  repositoryUrl           String   @default("")
  branch                  String   @default("main")
  jenkinsfilePath         String   @default("Jenkinsfile")
  pipelineScript          String   @default("")
  definitionMode          String   @default("scm")
  parameters              String   @default("[]")
  environment             String   @default("{}")
  environmentCredentialId String?
  domain                  String   @default("")
  applicationPort         Int?
  cloudflareCredentialId  String?
  cloudflareZoneId        String?
  configureDomain         Boolean  @default(false)
  applicationRoutes       String   @default("[]")
  lastStatus              String   @default("configured")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  project                 Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, folder, name])
  @@index([projectId])
  @@index([targetId])
  @@index([updatedAt])
}

model Template {
  id          String   @id
  projectId   String
  kind        String // 'infrastructure' | 'deployment'
  name        String
  description String   @default("")
  definition  String   @default("{}")
  builtIn     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Deployment {
  id         String    @id
  projectId  String
  status     String    @default("pending")
  strategy   String    @default("")
  outputs    String    @default("{}")
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logs    LogEntry[]

  @@index([projectId])
}

model LogEntry {
  id           String   @id
  deploymentId String?
  projectId    String
  level        String   @default("info")
  source       String   @default("app")
  message      String
  metadata     String   @default("{}")
  createdAt    DateTime @default(now())

  deployment Deployment? @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([deploymentId])
  @@index([projectId])
  @@index([createdAt])
}

model SshKey {
  id          String   @id
  projectId   String
  name        String
  publicKey   String
  ciphertext  String? // encrypted private key, optional
  fingerprint String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Secret {
  id         String   @id
  projectId  String
  name       String
  ciphertext String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

model Setting {
  projectId String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, key])
  @@index([projectId])
}

// Device-level preferences needed before a project is unlocked (updates,
// appearance, diagnostics). Runtime topology never uses this table.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Plugin {
  id        String
  projectId String
  name      String
  version   String
  kind      String // 'provider' | 'template' | 'widget' | 'theme' | ...
  enabled   Boolean  @default(true)
  manifest  String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, id])
  @@index([projectId])
}

model Activity {
  id        String   @id
  projectId String
  type      String
  message   String
  metadata  String   @default("{}")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}
